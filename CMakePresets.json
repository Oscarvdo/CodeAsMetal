{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-base", "hidden": true, "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows", "CAM_BUILD_DESKTOP": "ON",
        "VCPKG_MANIFEST_MODE": "OFF", "CAM_USE_GTEST": "ON", "BUILD_TESTING": "ON"
      }
    },
    {"name": "windows-debug", "inherits": "windows-base", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}},
    {"name": "windows-release", "inherits": "windows-base", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}},
    {"name": "core-only", "generator": "Ninja", "binaryDir": "${sourceDir}/out/build/core-only",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "CAM_BUILD_DESKTOP": "OFF", "CAM_USE_GTEST": "OFF"}}
  ],
  "buildPresets": [
    {"name": "windows-debug", "configurePreset": "windows-debug"},
    {"name": "windows-release", "configurePreset": "windows-release"},
    {"name": "core-only", "configurePreset": "core-only"}
  ],
  "testPresets": [
    {"name": "windows-debug", "configurePreset": "windows-debug", "output": {"outputOnFailure": true}},
    {"name": "windows-release", "configurePreset": "windows-release", "output": {"outputOnFailure": true}},
    {"name": "core-only", "configurePreset": "core-only", "output": {"outputOnFailure": true}}
  ]
}
